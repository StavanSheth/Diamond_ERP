{
  "name": "diamond-erp-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "DiamondERP V3.0 Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean-build-artifacts.js",
    "dev:api": "npm run dev --workspace=@diamond-erp/api",
    "dev:web": "npm run dev --workspace=@diamond-erp/web",
    "build:contracts": "npm run build --workspace=@diamond-erp/contracts",
    "build:utils": "npm run build --workspace=@diamond-erp/shared-utils",
    "build:client": "npm run build --workspace=@diamond-erp/api-client",
    "build:api": "npm run build --workspace=@diamond-erp/api",
    "build:web": "npm run build --workspace=@diamond-erp/web",
    "build:prod": "npm run clean && npm run build:contracts && npm run build:utils && npm run build:client && npm run build:api && npm run build:web && npm run verify:packaging",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build:installer": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /out:installer\\Installer.exe /target:winexe /win32icon:installer\\app.ico installer\\Installer.cs && C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /target:winexe /out:installer\\DiamondERP.exe /win32icon:installer\\app.ico /r:installer\\Microsoft.Web.WebView2.Core.dll /r:installer\\Microsoft.Web.WebView2.Wpf.dll /r:C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\WPF\\PresentationFramework.dll /r:C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\WPF\\PresentationCore.dll /r:C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\WPF\\WindowsBase.dll /r:C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\System.Xaml.dll /r:System.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll installer\\Launcher.cs",
    "seed": "npm run seed --workspace=@diamond-erp/api",
    "test": "npm run test --workspaces --if-present",
    "stage:windows": "node scripts/stage-windows-build.js",
    "verify:packaging": "node scripts/validate-packaging-readiness.js",
    "test:smoke": "node scripts/smoke-test-production.js",
    "test:smoke:staged": "node scripts/smoke-test-production.js --staged"
  }
}
