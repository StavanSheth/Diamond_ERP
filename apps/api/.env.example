# ═══════════════════════════════════════════════════════════════
# Diamond ERP V3.0 — API Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="file:../Stavan.db"

# ── Authentication ────────────────────────────────────────────
# REQUIRED in production (>= 32 characters)
# JWT_SECRET=your-secure-random-string-at-least-32-characters

# Optional: Override default access token TTL (default: 24h)
# JWT_EXPIRES_IN=24h

# Optional: Set default admin password on first run
# DEFAULT_ADMIN_PASSWORD=your-secure-admin-password

# Optional: Bootstrap secret for initial admin creation via API
# BOOTSTRAP_SECRET=your-bootstrap-secret

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated origins (REQUIRED in production)
# CORS_ORIGIN=https://your-domain.com

# ── Profiles (Multi-Tenant) ──────────────────────────────────
# Comma-separated list of additional profile codes
# CONFIGURED_PROFILES=ProfileA,ProfileB

# ── Google Sheets Integration (Optional) ─────────────────────
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=your-google-sheet-id

# ── Retry Configuration ──────────────────────────────────────
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_MS=250
