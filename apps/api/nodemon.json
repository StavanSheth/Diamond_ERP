{
  "watch": ["src"],
  "ext": "ts,js,json",
  "ignore": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "exports/**",
    "backups/**",
    "databases/**",
    "uploads/**",
    "logs/**",
    "*.db",
    "*.db-wal",
    "*.db-shm",
    "*.csv",
    "*.xlsx",
    "dist/**",
    "node_modules/**"
  ],
  "exec": "ts-node --transpile-only src/index.ts"
}
